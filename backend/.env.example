# ─── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─── MongoDB ─────────────────────────────────────────────────────────────────
# MongoDB Atlas example:
# MONGODB_URI=mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/cloudvault?retryWrites=true&w=majority
# Local Docker example:
MONGODB_URI=mongodb://cloudvault:cloudvault_secret@localhost:27017/cloudvault?authSource=admin

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change_this_access_secret_32chars_min
JWT_REFRESH_SECRET=change_this_refresh_secret_32chars_min
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ─── Storage ─────────────────────────────────────────────────────────────────
# Options: local | s3
STORAGE_PROVIDER=local
LOCAL_UPLOAD_DIR=./uploads

# S3 / R2 (only needed when STORAGE_PROVIDER=s3)
S3_BUCKET=cloudvault
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# For Cloudflare R2, set the endpoint:
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com

# ─── Email (SMTP) ─────────────────────────────────────────────────────────────
# Leave blank in development — reset tokens are logged to the console instead
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@cloudvault.app

# ─── Storage Quotas ───────────────────────────────────────────────────────────
# Default per-user quota in bytes (5 GB)
DEFAULT_STORAGE_QUOTA=5368709120

# ─── CORS ────────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10
